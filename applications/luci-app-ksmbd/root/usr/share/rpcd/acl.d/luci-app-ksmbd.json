{
	"luci-app-ksmbd": {
		"description": "Grant access to LuCI app ksmbd",
		"read": {
			"file": {
				"/etc/ksmbd/ksmbd.conf.template": [ "read" ],
				"/var/run/config/ksmbd": [ "read" ],
				"/tmp/run/config/ksmbd": [ "read" ],
				"/usr/sbin/ksmbd.mountd": [ "exec" ],
				"/sbin/modinfo": [ "exec" ]
			},
			"ubus": {
				"luci.ksmbd": [ "list" ]
			},
			"uci": [ "ksmbd" ]
		},
		"write": {
			"file": {
				"/etc/ksmbd/ksmbd.conf.template": [ "write" ],
				"/var/run/config/ksmbd": [ "write" ],
				"/tmp/run/config/ksmbd": [ "write" ],
				"/etc/init.d/ksmbd reload": [ "exec" ]
			},
			"ubus": {
				"luci.ksmbd": [ "add", "passwd", "delete" ]
			},
			"uci": [ "ksmbd" ]
		}
	}
}
